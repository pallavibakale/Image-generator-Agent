    "def generate_images_with_approval(num_img: int, tool_context: ToolContext) -> dict:\n",
    "    \"\"\"Approves or rejects a user request to generate an image. If more than 1 image generation is requested, approval from user is required.\n",
    "        Args:\n",
    "            num_img: Number of images to generate\n",
    "        Returns:\n",
    "            request status\"\"\"\n",
    "    if num_img <= 1:\n",
    "        return {\"status\": \"approved\", \"num_img\": num_img}\n",
    "    if not tool_context.tool_confirmation:\n",
    "        tool_context.request_confirmation(\n",
    "            hint=f\"Large request: {num_img} images to generate. Do you want to approve?\",\n",
    "            payload={\"num_img\": num_img},\n",
    "        )\n",
    "        return {\"status\": \"pending\", \"num_img\": num_img}\n",
    "    if tool_context.tool_confirmation.confirmed:\n",
    "        return {\"status\": \"approved\", \"num_img\": num_img}\n",
    "    else:\n",
    "        return {\"status\": \"rejected\", \"num_img\": num_img}"
   ]
  },
