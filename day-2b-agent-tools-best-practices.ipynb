    "# Create shipping agent with pausable tool\n",
    "img_coordinator = LlmAgent(\n",
    "    name=\"img_coordinator\",\n",
    "    model=Gemini(model=\"gemini-2.5-flash-lite\", retry_options=retry_config),\n",
    "    instruction=\"\"\"You are an image generation coordinator assistant.\n",
    "\n",
    "When users request to generate images:\n",
    "  1. Always call `generate_images_with_approval` with the number of images requested.\n",
    "  2. If the tool returns `{\"status\": \"pending\"}`, tell the user that approval is required and wait.\n",
    "  3. After receiving the final result (`approved` or `rejected`), summarize:\n",
    "     - Order status\n",
    "     - Number of images\n",
    "  \"\"\",\n",
    "    tools=[FunctionTool(func=generate_images_with_approval)],\n",
    ")\n",
    "\n",
    "print(\"✅ Agent created!\")"
   ]
